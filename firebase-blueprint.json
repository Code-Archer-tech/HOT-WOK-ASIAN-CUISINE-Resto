{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Menu category definition for Hot Wok Asian Cuisine",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier" },
        "name": { "type": "string", "description": "Display name of category" },
        "description": { "type": "string", "description": "Category description" },
        "icon": { "type": "string", "description": "Lucide icon name" },
        "sortOrder": { "type": "number", "description": "Visual display sorting order" },
        "cuisine": { "type": "string", "description": "Pan-Asian cuisine style" }
      },
      "required": ["id", "name", "sortOrder"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Culinary item on the Hot Wok restaurant menu",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique menu dish ID" },
        "name": { "type": "string", "description": "Dish title" },
        "description": { "type": "string", "description": "Dish culinary description" },
        "categoryId": { "type": "string", "description": "Reference to parent category" },
        "cuisine": { "type": "string", "description": "Cuisine category" },
        "dietary": { "type": "string", "description": "Dietary classification" },
        "spiceLevel": { "type": "number", "description": "Spice meter from 0 to 3" },
        "price": { "type": "number", "description": "Single or base price in INR" },
        "isAvailable": { "type": "boolean", "description": "In-stock kitchen status" },
        "isChefSpecial": { "type": "boolean", "description": "Chef recommendation badge" },
        "isBestseller": { "type": "boolean", "description": "Top-ordered badge" },
        "sortOrder": { "type": "number", "description": "Order sequence" }
      },
      "required": ["id", "name", "categoryId", "price", "isAvailable"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food order record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "orderNumber": { "type": "string", "description": "Human-readable order number" },
        "orderType": { "type": "string", "description": "Delivery, dine_in, or pickup" },
        "status": { "type": "string", "description": "Current kitchen status" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "customerPhone": { "type": "string", "description": "Customer mobile phone number" },
        "subtotal": { "type": "number", "description": "Order subtotal before taxes and fees" },
        "total": { "type": "number", "description": "Grand total payable in INR" },
        "createdAt": { "type": "string", "description": "ISO timestamp of order creation" }
      },
      "required": ["id", "orderNumber", "orderType", "status", "customerName", "customerPhone", "total"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Complete table booking and dining reservation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique reservation ID" },
        "reservationNumber": { "type": "string", "description": "Human-readable booking code e.g. HW-20260921-0001" },
        "customerName": { "type": "string", "description": "Lead guest name" },
        "customerPhone": { "type": "string", "description": "Lead guest Indian mobile number" },
        "customerEmail": { "type": "string", "description": "Optional contact email" },
        "bookingDate": { "type": "string", "description": "Booking date string YYYY-MM-DD" },
        "bookingTime": { "type": "string", "description": "Booking time slot HH:MM" },
        "guestCount": { "type": "number", "description": "Number of diners" },
        "occasion": { "type": "string", "description": "Celebration type" },
        "specialRequest": { "type": "string", "description": "Dietary or seating note" },
        "status": { "type": "string", "description": "PENDING, CONFIRMED, REJECTED, CANCELLED, COMPLETED, NO_SHOW" },
        "assignedTableId": { "type": "string", "description": "ID of assigned dining table" },
        "assignedTableNumber": { "type": "string", "description": "Display number of assigned table" },
        "managerNote": { "type": "string", "description": "Internal note" },
        "rejectionReason": { "type": "string", "description": "Customer-facing reason" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" },
        "confirmedAt": { "type": "string", "description": "Confirmation ISO timestamp" },
        "cancelledAt": { "type": "string", "description": "Cancellation ISO timestamp" }
      },
      "required": ["id", "reservationNumber", "customerName", "customerPhone", "bookingDate", "bookingTime", "guestCount", "status"]
    },
    "RestaurantTable": {
      "title": "RestaurantTable",
      "description": "Dining table in the restaurant",
      "type": "object",
      "properties": {
        "tableId": { "type": "string", "description": "Unique table ID" },
        "tableNumber": { "type": "string", "description": "Table identifier e.g. T01" },
        "capacity": { "type": "number", "description": "Maximum seating capacity" },
        "location": { "type": "string", "description": "Physical section in restaurant" },
        "status": { "type": "string", "description": "AVAILABLE, RESERVED, MAINTENANCE" }
      },
      "required": ["tableId", "tableNumber", "capacity", "status"]
    },
    "ReservationEvent": {
      "title": "ReservationEvent",
      "description": "Activity timeline and audit log for a reservation",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "description": "Unique event ID" },
        "reservationId": { "type": "string", "description": "Associated reservation ID" },
        "eventType": { "type": "string", "description": "Type of event" },
        "actorType": { "type": "string", "description": "CUSTOMER, MANAGER, SYSTEM" },
        "actorId": { "type": "string", "description": "ID of actor" },
        "message": { "type": "string", "description": "Readable description" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["eventId", "reservationId", "eventType", "actorType", "message", "createdAt"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Customer notification communication record",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "description": "Unique notification ID" },
        "reservationId": { "type": "string", "description": "Associated reservation ID" },
        "channel": { "type": "string", "description": "WHATSAPP, SMS, EMAIL" },
        "recipient": { "type": "string", "description": "Recipient phone or email" },
        "messageType": { "type": "string", "description": "Notification category" },
        "status": { "type": "string", "description": "PENDING, SENT, FAILED" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["notificationId", "reservationId", "channel", "recipient", "messageType", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer dining review and rating",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Review unique identifier" },
        "author": { "type": "string", "description": "Reviewer name" },
        "rating": { "type": "number", "description": "1 to 5 star rating" },
        "comment": { "type": "string", "description": "Review feedback" },
        "approved": { "type": "boolean", "description": "Moderation status" },
        "createdAt": { "type": "string", "description": "ISO date string" }
      },
      "required": ["id", "author", "rating", "comment", "approved"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of food categories"
    },
    "/menu_items/{itemId}": {
      "schema": "MenuItem",
      "description": "Collection of all Asian dishes and beverages"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer dine-in, takeaway, and delivery orders"
    },
    "/reservations/{resId}": {
      "schema": "Reservation",
      "description": "Collection of dining table reservations"
    },
    "/restaurant_tables/{tableId}": {
      "schema": "RestaurantTable",
      "description": "Collection of restaurant dining tables"
    },
    "/reservation_events/{eventId}": {
      "schema": "ReservationEvent",
      "description": "Activity timeline and audit log for table reservations"
    },
    "/notification_logs/{notifId}": {
      "schema": "NotificationLog",
      "description": "Customer notification and communication history"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of customer testimonials"
    }
  }
}
