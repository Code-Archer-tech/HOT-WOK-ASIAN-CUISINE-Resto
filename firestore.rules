rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Menu items collection
    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Reservations collection
    match /reservations/{resId} {
      allow read, write: if true;
    }

    // Restaurant Tables collection
    match /restaurant_tables/{tableId} {
      allow read, write: if true;
    }

    // Reservation Activity Events Timeline
    match /reservation_events/{eventId} {
      allow read, write: if true;
    }

    // Notification Logs
    match /notification_logs/{notifId} {
      allow read, write: if true;
    }

    // Customer Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Customer Contact Messages & Enquiries collection
    match /contact_messages/{msgId} {
      allow read, write: if true;
    }

    // Admin profiles / settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
